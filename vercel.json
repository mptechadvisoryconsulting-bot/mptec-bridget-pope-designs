{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/event-countdown",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/consultation-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "0 16 * * *"
    }
  ]
}
